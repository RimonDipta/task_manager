# Copy this file to `.env` in the `server` directory and fill in real values.
# Never commit the real `.env` file.

PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_super_secret_key

# Email Configuration (for OTPs and 2FA emails)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Doora

# Development URLs
CLIENT_URL_DEV=http://localhost:5173
API_URL_DEV=http://localhost:5000

# Production URLs
CLIENT_URL_PROD=https://your-production-app.netlify.app
API_URL_PROD=https://your-production-api.onrender.com

# Optional: Cloudinary (profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
